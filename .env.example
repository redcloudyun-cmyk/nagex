# NAgex configuration example. Copy to the real environment file (never commit real values) and fill in.
# Do not put real secrets in this example file.

# ── Where this deployment lives (one place) ────────────────────────────────────────────────────────────────
# The canonical public ORIGIN of this deployment. Every OAuth redirect URI below is derived from it unless you
# set that integration's own *_REDIRECT_URI explicitly, so changing the address means changing this one line
# (and registering the new redirect URIs with Google / Microsoft / GitHub - see deploy/nagex/README.md).
#   deployed (nagex-server, behind a Cloudflare Tunnel with Cloudflare Access):  https://nagex.agex.site
#   local development:                                                          http://127.0.0.1:8085
# It must be an origin: https://host (http only for localhost / 127.0.0.1), no path. An invalid value is ignored and logged.
NAGEX_PUBLIC_URL=http://127.0.0.1:8085

# The internal API address the reverse proxy / tunnel connects to.
PORT=8085
HOST=127.0.0.1

# Behind cloudflared the TCP peer is the tunnel client on loopback: list it so X-Forwarded-For (the real client address)
# is trusted - and only from there. Leave unset when there is no proxy.
#NAGEX_TRUSTED_PROXIES=127.0.0.1,::1

# The browser app is same-origin, so no CORS origin is needed. Set only for another origin that must call the API.
#NAGEX_CORS_ALLOWED_ORIGINS=

# Session cookies are Secure by default (they need https; localhost counts as secure). Local plain-http development only:
#NAGEX_INSECURE_COOKIES_FOR_LOCAL_DEV=1

# Encrypts stored OAuth tokens and SSO client secrets (base64, 32 bytes: openssl rand -base64 32). Required for persistence.
NAGEX_TOKEN_ENCRYPTION_KEY=

# ── End-user sign-in (Google and Microsoft only) ───────────────────────────────────────────────────────────
# Redirect URIs to register: <NAGEX_PUBLIC_URL>/api/v1/auth/oauth/google/callback and /api/v1/auth/oauth/microsoft/callback
# Leave the *_REDIRECT_URI lines empty to use the derived values; set one only to override it.

# Google
NAGEX_GOOGLE_LOGIN_CLIENT_ID=
NAGEX_GOOGLE_LOGIN_CLIENT_SECRET=
NAGEX_GOOGLE_LOGIN_REDIRECT_URI=

# Microsoft
NAGEX_MICROSOFT_LOGIN_CLIENT_ID=
NAGEX_MICROSOFT_LOGIN_CLIENT_SECRET=
NAGEX_MICROSOFT_LOGIN_REDIRECT_URI=

# ── Connected apps (separate consent from signing in) ──────────────────────────────────────────────────────
# Google Calendar / Gmail connection. Redirect URI to register: <NAGEX_PUBLIC_URL>/api/v1/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# GitHub (read-only repository access). Redirect URI to register: <NAGEX_PUBLIC_URL>/api/v1/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
