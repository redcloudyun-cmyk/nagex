# NAgex end-user OAuth/OIDC login
#
# Current end-user auth policy allows only Google and Microsoft. Do not put real
# secrets in this example file.

# Google
NAGEX_GOOGLE_LOGIN_CLIENT_ID=
NAGEX_GOOGLE_LOGIN_CLIENT_SECRET=
NAGEX_GOOGLE_LOGIN_REDIRECT_URI=http://127.0.0.1:8085/api/v1/auth/oauth/google/callback

# Microsoft
NAGEX_MICROSOFT_LOGIN_CLIENT_ID=
NAGEX_MICROSOFT_LOGIN_CLIENT_SECRET=
NAGEX_MICROSOFT_LOGIN_REDIRECT_URI=http://127.0.0.1:8085/api/v1/auth/oauth/microsoft/callback
