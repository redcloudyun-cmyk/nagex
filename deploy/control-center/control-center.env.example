# Copy to /etc/nagex/control-center.env on the server with root/service-owner
# readable permissions. Admin authority is Cloudflare Access verified JWT
# plus exact-email allowlist only; no static bearer admin token is supported.
NAGEX_CONTROL_ADMIN_ALLOWLIST=redcloudyun@gmail.com:SUPER_ADMIN
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUDIENCE=your-cloudflare-access-audience
NAGEX_CONTROL_ADMIN_SESSION_SECRET=replace-with-random-session-secret
