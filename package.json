{
  "name": "nagex-core",
  "version": "0.1.0",
  "description": "NAgex AI Operating System - Modular Monolith Core",
  "main": "dist/src/desktop/desktop-app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server_web.js",
    "desktop:dev": "tsc && electron .",
    "desktop:build": "tsc && electron-builder --win nsis",
    "test": "npm run test:regression",
    "test:all-legacy": "tsc && node --require ./dist/tests/_setup.js --test dist/tests/*.test.js",
    "test:gate": "node scripts/nagex-test-gate.mjs",
    "test:regression": "node scripts/nagex-test-gate.mjs regression",
    "test:browser-cert": "node scripts/nagex-test-gate.mjs browser",
    "test:deployed-cert": "node scripts/nagex-test-gate.mjs deployed",
    "test:live": "node scripts/nagex-test-gate.mjs live",
    "test:legacy": "node scripts/nagex-test-gate.mjs legacy",
    "test:scope": "node scripts/nagex-test-scope.mjs",
    "test:architecture": "npm run test:scope -- architecture",
    "test:browser": "npm run test:scope -- browser",
    "test:google": "npm run test:scope -- google",
    "test:tasks": "npm run test:scope -- tasks",
    "test:runtime": "npm run test:scope -- runtime",
    "test:device": "npm run test:scope -- device",
    "test:personal-home": "npm run test:scope -- personal-home",
    "test:memory-context": "npm run test:scope -- memory-context",
    "test:capture": "npm run test:scope -- capture",
    "test:model-routing": "npm run test:scope -- model-routing",
    "test:mobile": "npm run test:scope -- mobile",
    "test:personal-context": "npm run test:scope -- personal-context"
  },
  "build": {
    "appId": "com.nagex.desktop",
    "productName": "NAgex Desktop Quick Wake",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "keywords": [
    "nagex",
    "ai-os",
    "runtime",
    "agent",
    "workflow"
  ],
  "author": "NAgex Core Team",
  "license": "MIT",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/pdfkit": "^0.17.6",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "pdfkit": "^0.20.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "js-yaml": "^5.3.0",
    "pdfjs-dist": "^5.4.296",
    "playwright": "^1.63.0"
  }
}
