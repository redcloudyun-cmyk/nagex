{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agex://schema/common/error/v1",
  "title": "AGEX Standard API Error Schema",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "category", "message", "request_id"],
      "properties": {
        "code": {
          "type": "string",
          "description": "Stable Error Code (예: POLICY_DENIED, NOT_FOUND, QUOTA_EXCEEDED)"
        },
        "category": {
          "type": "string",
          "enum": [
            "AUTHENTICATION",
            "AUTHORIZATION",
            "POLICY",
            "VALIDATION",
            "NOT_FOUND",
            "CONFLICT",
            "QUOTA",
            "RATE_LIMIT",
            "RUNTIME",
            "PROVIDER",
            "TIMEOUT",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string",
          "description": "Human-readable error description"
        },
        "request_id": {
          "type": "string",
          "description": "Unique Request Tracking ID"
        },
        "correlation_id": {
          "type": ["string", "null"],
          "description": "Correlation ID for distributed tracing"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
