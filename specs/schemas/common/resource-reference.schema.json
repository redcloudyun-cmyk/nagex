{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agex://schema/common/resource-reference/v1",
  "title": "AGEX Resource Reference Schema",
  "type": "object",
  "required": ["type", "id"],
  "properties": {
    "type": {
      "type": "string",
      "description": "Resource Type / Kind (예: Agent, Workflow, Model)"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2,4}_[a-zA-Z0-9_-]+$",
      "description": "Target Resource ID"
    },
    "version": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Version Pinning (선택적)"
    }
  },
  "additionalProperties": false
}
