{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agex://schema/identity/user/v1",
  "title": "AGEX User Resource Schema",
  "type": "object",
  "required": ["api_version", "kind", "metadata", "specification", "status"],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": ["agex/v1"]
    },
    "kind": {
      "type": "string",
      "enum": ["User"]
    },
    "metadata": {
      "$ref": "agex://schema/common/resource-metadata/v1"
    },
    "specification": {
      "type": "object",
      "required": ["display_name", "primary_identity_provider"],
      "properties": {
        "display_name": {
          "type": "string"
        },
        "primary_identity_provider": {
          "type": "string"
        },
        "email": {
          "type": ["string", "null"],
          "format": "email"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["INVITED", "ACTIVE", "SUSPENDED", "DISABLED", "DELETED"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
