{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nagex://schema/model/plan-preview/v1",
  "title": "NAgex Model-generated Plan Preview",
  "type": "object",
  "required": ["status", "message", "plan", "provider", "model", "latencyMs", "requestId"],
  "properties": {
    "status": { "const": "PLAN_PREVIEW" },
    "message": { "type": "string" },
    "plan": {
      "type": "object",
      "required": ["goal", "summary", "reasoningSummary", "steps"],
      "properties": {
        "goal": { "type": "string" },
        "summary": { "type": "string" },
        "reasoningSummary": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["step", "title", "reasoning", "skill", "tool", "requiresApproval"],
            "properties": {
              "step": { "type": "integer", "minimum": 1 },
              "title": { "type": "string" },
              "reasoning": { "type": "string" },
              "skill": { "type": "string" },
              "tool": { "type": ["string", "null"] },
              "requiresApproval": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string" },
    "latencyMs": { "type": "number", "minimum": 0 },
    "requestId": { "type": "string" }
  },
  "additionalProperties": false
}
